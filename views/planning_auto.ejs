<%- include('partials/header') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="fas fa-calendar-alt text-primary"></i>
                Planification Automatique des Courses
            </h1>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-upload"></i>
                        Upload du fichier de réservations
                    </h5>
                    <button type="button" class="btn btn-sm btn-light" id="loadSampleBtn">
                        <i class="fas fa-file-alt"></i> Charger un exemple de test
                    </button>
                </div>
                <div class="card-body">
                    <form id="uploadForm" enctype="multipart/form-data" method="post">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="reservation_file" class="form-label">
                                        <strong>Fichier de réservations (.txt / .eml)</strong>
                                    </label>
                                    <input type="file" class="form-control" id="reservation_file"
                                           name="reservation_file" accept=".txt,.eml">
                                    <div class="form-text">
                                        Sélectionnez le fichier texte contenant les réservations de Nice au format standard, ou cliquez sur <em>Charger un exemple de test</em> ci-dessus.
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="target_date" class="form-label">
                                        <strong>Date du planning</strong>
                                    </label>
                                    <input type="date" class="form-control" id="target_date"
                                           name="target_date" value="<%= typeof tomorrow_date !== 'undefined' ? tomorrow_date : '' %>">
                                    <div class="form-text">
                                        Date pour laquelle créer le planning.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary-custom btn-lg py-3" id="generateBtn">
                                <i class="fas fa-magic me-2"></i>
                                Générer le Planning Automatiquement
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Message d'erreur dynamique -->
            <div id="errorAlert" class="alert alert-danger mt-3" style="display: none;"></div>

            <!-- Zone de progression -->
            <div id="progressSection" class="mt-4" style="display: none;">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold mb-3">
                            <i class="fas fa-cog fa-spin text-primary me-2"></i>
                            Optimisation du planning en cours...
                        </h5>
                        <div class="progress my-3" style="height: 14px; border-radius: 9999px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                 role="progressbar" style="width: 0%"></div>
                        </div>
                        <div id="progressText" class="mt-2 text-muted fw-semibold small">
                            Initialisation...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Résultats -->
            <div id="resultsSection" class="mt-4" style="display: none;">
                <div class="alert alert-success shadow-sm p-4">
                    <h5 class="fw-bold text-success mb-2">
                        <i class="fas fa-check-circle me-2"></i>
                        Planning généré avec succès !
                    </h5>
                    <div id="resultsText" class="my-2"></div>
                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <a href="/show_planning" class="btn btn-primary-custom">
                            <i class="fas fa-eye me-1"></i> Consulter le Planning
                        </a>
                        <a href="/export_planning" class="btn btn-outline-secondary">
                            <i class="fas fa-download me-1"></i> Télécharger en TXT
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sections d'informations -->
    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-info-circle me-2"></i>
                        Comment fonctionne l'algorithme ?
                    </h5>
                </div>
                <div class="card-body">
                    <ol class="mb-0">
                        <li class="mb-2"><strong>Upload</strong> : Chargez votre fichier de réservations au format texte</li>
                        <li class="mb-2"><strong>Analyse</strong> : Le système analyse automatiquement chaque réservation (heure, patient, adresse, destination)</li>
                        <li class="mb-2"><strong>Géolocalisation</strong> : Les adresses sont géolocalisées sur les secteurs de Nice</li>
                        <li class="mb-2"><strong>Optimisation</strong> : L'algorithme assigne les courses aux taxis selon secteurs et disponibilités</li>
                        <li><strong>Planning</strong> : Un planning optimisé est généré et sauvegardé</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-lightbulb text-warning me-2"></i>
                        Critères d'optimisation
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li class="mb-1">Proximité géographique (Secteurs Nice S10, S20, S22, S30, S40, S60, S70)</li>
                        <li class="mb-1">Disponibilité réelle de chaque taxi (semaine / week-end)</li>
                        <li class="mb-1">Intervalles de temps appropriés (30min - 1h entre prises en charge)</li>
                        <li class="mb-1">Minimisation des trajets à vide entre hôpitaux et domiciles</li>
                        <li class="mb-1">Équilibrage de la charge entre l'ensemble des chauffeurs</li>
                        <li>Prise en compte des consignes spécifiques (chimio, ponctualité, transport)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-tools"></i>
                        Actions Rapides
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <a href="/manage_taxis" class="btn btn-outline-primary me-2">
                            <i class="fas fa-taxi"></i> Gérer les Taxis
                        </a>
                        <a href="/planning_history" class="btn btn-outline-info me-2">
                            <i class="fas fa-history"></i> Historique des Plannings
                        </a>
                        <a href="/about" class="btn btn-outline-secondary">
                            <i class="fas fa-question-circle"></i> Aide & À propos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const dateInput = document.getElementById('target_date');
    if (!dateInput.value) {
        dateInput.value = tomorrow.toISOString().split('T')[0];
    }

    const sampleReservations = `07H30 (LEFEBVRE Christine) 18 Rue Vernier Nice - 06 11 22 33 44 DEST NICE HOPITAL ARCHET 2 <<BT AU RETOUR
EXO OUI
DOIT ETRE A L HEURE

08H15 (BENHAMOU David) 3 Boulevard Cessole Nice - 04 93 51 20 10 DEST Nice LACASSAGNE BAT A <<BT FOURNI
CHIMIO

08H45 (GARCIA Manuel) 102 Promenade des Anglais Nice - 06 55 44 33 22 DEST NICE HOPITAL PASTEUR 2 <<BT AU RETOUR
EXO OUI

09H30 (DUPONT Marie) 5 Rue Trachel Nice - 06 77 88 99 00 DEST NICE IUFC <<
OUVRIR LES PORTES

10H00 (MOREAU André) 45 Avenue Jean Médecin Nice - 04 93 88 12 34 DEST Nice CYCLOTRON <<BT AU RETOUR
IMMUNOTHERAPIE
EXO OUI

11H15 (BERTRAND Jacqueline) 12 Rue de Suisse Nice - 06 33 22 11 00 DEST Hôpital Les Sources <<
DOIT ETRE A L HEURE

13H30 (LAMBERT Paul) 87 Boulevard Gorbella Nice - 06 44 55 66 77 DEST NICE HOPITAL ARCHET 2 <<BT AU RETOUR
EXO OUI

14H15 (FAURE Sylvie) 24 Avenue de la République Nice - 06 99 88 77 66 DEST Nice LACASSAGNE BAT B <<
CHIMIO

15H00 (MERCIER Alain) 15 Avenue Malaussena Nice - 04 93 13 45 67 DEST NICE HOPITAL PASTEUR 2 <<
EXO OUI`;

    // Bouton charger un exemple de test
    document.getElementById('loadSampleBtn').addEventListener('click', function() {
        const file = new File([sampleReservations], 'reservations_exemple_nice.txt', { type: 'text/plain' });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        document.getElementById('reservation_file').files = dataTransfer.files;

        const errorAlert = document.getElementById('errorAlert');
        errorAlert.className = 'alert alert-info mt-3';
        errorAlert.innerHTML = '<i class="fas fa-check-circle"></i> Fichier d\'exemple de réservations Nice chargé (9 courses). Vous pouvez cliquer sur <strong>Générer le Planning Automatiquement</strong> !';
        errorAlert.style.display = 'block';
    });

    // Soumission du formulaire
    document.getElementById('uploadForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('reservation_file');
        const errorAlert = document.getElementById('errorAlert');
        errorAlert.style.display = 'none';

        if (!fileInput.files || fileInput.files.length === 0) {
            errorAlert.className = 'alert alert-danger mt-3';
            errorAlert.textContent = 'Veuillez sélectionner un fichier ou cliquer sur "Charger un exemple de test".';
            errorAlert.style.display = 'block';
            return;
        }

        const formData = new FormData(this);
        processUpload(formData);
    });

    function processUpload(formData) {
        const progressSection = document.getElementById('progressSection');
        const resultsSection = document.getElementById('resultsSection');
        const generateBtn = document.getElementById('generateBtn');
        const progressBar = document.querySelector('.progress-bar');
        const progressText = document.getElementById('progressText');
        const errorAlert = document.getElementById('errorAlert');

        progressSection.style.display = 'block';
        resultsSection.style.display = 'none';
        errorAlert.style.display = 'none';
        generateBtn.disabled = true;

        let progress = 10;
        progressBar.style.width = '10%';
        progressText.textContent = 'Lecture du fichier...';

        const progressMessages = [
            'Analyse des réservations...',
            'Géolocalisation des adresses sur Nice...',
            'Calcul des temps de parcours et secteurs...',
            'Optimisation de l\'attribution aux taxis...',
            'Finalisation et archivage du planning...'
        ];

        let msgIdx = 0;
        const progressInterval = setInterval(() => {
            progress += 15;
            if (progress > 85) progress = 85;
            progressBar.style.width = progress + '%';
            if (msgIdx < progressMessages.length) {
                progressText.textContent = progressMessages[msgIdx++];
            }
        }, 300);

        fetch('/upload_reservations', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            clearInterval(progressInterval);
            progressBar.style.width = '100%';
            progressText.textContent = 'Planning prêt !';

            setTimeout(() => {
                progressSection.style.display = 'none';
                generateBtn.disabled = false;

                if (data.success) {
                    const resultsText = document.getElementById('resultsText');
                    resultsText.innerHTML = `
                        <p class="mb-1"><strong>${data.courses_found}</strong> réservations analysées avec succès.</p>
                        <p class="mb-1">Planning optimisé créé pour l'ensemble des chauffeurs disponibles.</p>
                        ${data.auto_saved ? '<p class="text-success mb-0"><i class="fas fa-save"></i> <strong>Sauvegardé automatiquement dans l\'historique</strong></p>' : ''}
                    `;
                    resultsSection.style.display = 'block';
                } else if (data.planning_exists) {
                    showExistingPlanningDialog(data);
                } else {
                    errorAlert.className = 'alert alert-danger mt-3';
                    errorAlert.textContent = 'Erreur: ' + (data.error || 'Erreur inconnue');
                    errorAlert.style.display = 'block';
                }
            }, 600);
        })
        .catch(error => {
            clearInterval(progressInterval);
            progressSection.style.display = 'none';
            generateBtn.disabled = false;
            errorAlert.className = 'alert alert-danger mt-3';
            errorAlert.textContent = 'Erreur lors du traitement: ' + error.message;
            errorAlert.style.display = 'block';
        });
    }

    function showExistingPlanningDialog(data) {
        const dialog = document.createElement('div');
        dialog.className = 'modal fade';
        dialog.innerHTML = `
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title">
                            <i class="fas fa-exclamation-triangle"></i>
                            Planning existant
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info">
                            <h6><i class="fas fa-info-circle"></i> Un planning existe déjà pour cette date !</h6>
                            <ul class="mb-0">
                                <li><strong>Date :</strong> ${data.existing_planning.date}</li>
                                <li><strong>Courses :</strong> ${data.existing_planning.total_courses}</li>
                                <li><strong>Taxis utilisés :</strong> ${data.existing_planning.taxis_used}</li>
                            </ul>
                        </div>
                        <p>Que souhaitez-vous faire ?</p>
                    </div>
                    <div class="modal-footer">
                        <a href="${data.view_url}" class="btn btn-primary">
                            <i class="fas fa-eye"></i> Consulter le planning existant
                        </a>
                        <button type="button" class="btn btn-warning" id="confirmReplaceBtn">
                            <i class="fas fa-sync-alt"></i> Remplacer par le nouveau
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Annuler
                        </button>
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(dialog);
        const modal = new bootstrap.Modal(dialog);
        modal.show();

        dialog.querySelector('#confirmReplaceBtn').addEventListener('click', function() {
            modal.hide();
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            formData.append('force_replace', 'true');
            processUpload(formData);
        });

        dialog.addEventListener('hidden.bs.modal', () => {
            dialog.remove();
        });
    }
});
</script>

<%- include('partials/footer') %>
