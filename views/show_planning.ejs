<%- include('partials/header') %>

<div class="container-fluid mt-4 px-lg-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h1 class="h2 mb-1">
                        <i class="fas fa-calendar-check text-primary me-2"></i>
                        Planning du <%= target_date %>
                        <% if (typeof is_saved_planning !== 'undefined' && is_saved_planning) { %>
                        <span class="badge bg-success ms-2 fs-6">Archivé</span>
                        <% } %>
                    </h1>
                    <span class="text-muted small">Synthèse des courses affectées et feuilles de route chauffeurs</span>
                </div>
                <div class="mt-3 mt-md-0 d-flex gap-2">
                    <% if (typeof is_saved_planning !== 'undefined' && is_saved_planning) { %>
                    <a href="/export_saved_planning/<%= target_date %>" class="btn btn-outline-success">
                        <i class="fas fa-download me-1"></i> Télécharger TXT
                    </a>
                    <% } else { %>
                    <a href="/export_planning" class="btn btn-outline-success">
                        <i class="fas fa-download me-1"></i> Télécharger TXT
                    </a>
                    <button id="saveBtn" class="btn btn-primary-custom">
                        <i class="fas fa-save me-1"></i> Sauvegarder
                    </button>
                    <% } %>
                    <a href="/planning_history" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Historique
                    </a>
                </div>
            </div>

            <!-- Statistiques du Planning -->
            <% if (typeof statistics !== 'undefined' && statistics) { %>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Total Courses</span>
                            <h3 class="mb-0 fw-bold text-primary"><%= statistics.total_courses %></h3>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Courses Assignées</span>
                            <h3 class="mb-0 fw-bold text-success"><%= statistics.assigned_courses %></h3>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Non assignées</span>
                            <h3 class="mb-0 fw-bold <%= statistics.unassigned_courses > 0 ? 'text-danger' : 'text-muted' %>"><%= statistics.unassigned_courses %></h3>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Taxis Utilisés</span>
                            <h3 class="mb-0 fw-bold text-info"><%= statistics.taxis_used %></h3>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Distance Totale</span>
                            <h3 class="mb-0 fw-bold text-dark"><%= Math.round(statistics.total_km) %> <small class="fs-6 fw-normal text-muted">km</small></h3>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center py-2 shadow-sm border-0 bg-white">
                        <div class="card-body p-2">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Temps de Route</span>
                            <h3 class="mb-0 fw-bold text-warning"><%= statistics.total_duration_hours %> <small class="fs-6 fw-normal text-muted">h</small></h3>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Planning par taxi -->
            <div class="row">
                <% 
                let hasTaxisWithCourses = false;
                if (typeof taxis !== 'undefined' && taxis) {
                    Object.keys(taxis).forEach(function(taxiId) {
                        const taxiInfo = taxis[taxiId];
                        if (taxiInfo.courses && taxiInfo.courses.length > 0) {
                            hasTaxisWithCourses = true;
                %>
                <div class="col-md-6 col-xl-6 mb-4">
                    <div class="card taxi-planning-card shadow-sm h-100">
                        <div class="taxi-card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0 text-white fw-bold">
                                    <i class="fas fa-taxi text-warning me-2"></i>
                                    <%= taxiInfo.name %>
                                </h5>
                                <% if (taxiInfo.phone) { %>
                                <small class="text-white-50">Radio / Tél : <%= taxiInfo.phone %></small>
                                <% } %>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark me-1"><%= taxiInfo.courses.length %> course(s)</span>
                                <span class="badge bg-primary text-white"><%= Math.round(taxiInfo.total_km) %> km</span>
                            </div>
                        </div>
                        <div class="card-body p-3 bg-light">
                            <% 
                            const sortedCourses = [...taxiInfo.courses].sort((a, b) => a.time.localeCompare(b.time));
                            sortedCourses.forEach(function(course) { 
                            %>
                            <div class="course-item shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="time-pill">
                                        <i class="fas fa-clock me-1"></i><%= course.time %>
                                    </span>
                                    <div>
                                        <% if (course.exoneration) { %>
                                        <span class="badge bg-success me-1">EXO OUI</span>
                                        <% } %>
                                        <% if (course.transport_info) { %>
                                        <span class="badge bg-secondary"><%= course.transport_info %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <h6 class="fw-bold mb-2 text-dark">
                                    <i class="fas fa-user-circle me-1 text-primary"></i>
                                    <%= course.patient_name %>
                                    <% if (course.phone) { %>
                                    <small class="text-muted ms-2 fw-normal"><i class="fas fa-phone-alt me-1"></i><%= course.phone %></small>
                                    <% } %>
                                </h6>
                                <div class="mb-1 small">
                                    <span class="text-muted">Départ:</span>
                                    <i class="fas fa-map-pin text-success ms-1 me-1"></i>
                                    <strong><%= course.pickup_address %></strong>
                                </div>
                                <div class="mb-1 small">
                                    <span class="text-muted">Destination:</span>
                                    <i class="fas fa-hospital text-primary ms-1 me-1"></i>
                                    <strong><%= course.destination %></strong>
                                </div>
                                <% if (course.special_instructions) { %>
                                <div class="alert alert-warning py-1 px-2 my-2 small">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    <%= course.special_instructions %>
                                </div>
                                <% } %>
                                <div class="d-flex justify-content-between text-muted small mt-2 pt-2 border-top">
                                    <span><i class="fas fa-route me-1 text-primary"></i> <%= course.estimated_distance_km ? course.estimated_distance_km.toFixed(1) : '8.0' %> km</span>
                                    <span><i class="fas fa-hourglass-half me-1 text-info"></i> ~<%= course.estimated_duration_minutes || 25 %> min</span>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <% 
                        }
                    });
                } 
                if (!hasTaxisWithCourses) {
                %>
                <div class="col-12">
                    <div class="alert alert-info">
                        Aucune course n'est attribuée dans ce planning.
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Courses non assignées s'il y en a -->
            <% if (typeof planning !== 'undefined' && planning.unassigned_courses && planning.unassigned_courses.length > 0) { %>
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card border-danger shadow-sm">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Courses Non Assignées (<%= planning.unassigned_courses.length %>)
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <% planning.unassigned_courses.forEach(function(course) { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                    <div>
                                        <span class="badge bg-danger me-2"><%= course.time %></span>
                                        <strong><%= course.patient_name %></strong> : <%= course.pickup_address %> &rarr; <%= course.destination %>
                                    </div>
                                    <small class="text-muted"><%= course.phone %></small>
                                </li>
                                <% }); %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const saveBtn = document.getElementById('saveBtn');
    if (saveBtn) {
        saveBtn.addEventListener('click', function() {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Sauvegarde...';

            fetch('/save_planning', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    saveBtn.className = 'btn btn-success';
                    saveBtn.innerHTML = '<i class="fas fa-check me-1"></i> Sauvegardé';
                } else {
                    saveBtn.disabled = false;
                    saveBtn.className = 'btn btn-primary-custom';
                    saveBtn.innerHTML = '<i class="fas fa-save me-1"></i> Sauvegarder';
                }
            })
            .catch(() => {
                saveBtn.disabled = false;
                saveBtn.className = 'btn btn-primary-custom';
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i> Sauvegarder';
            });
        });
    }
});
</script>

<%- include('partials/footer') %>
